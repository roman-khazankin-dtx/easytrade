# Pre-built image refs (used by compose.yaml / CI)
TAG=fa6ccf2
REGISTRY=europe-docker.pkg.dev/dynatrace-demoability/docker/easytrade

# Dynatrace — required for OneAgent injection in accountservice (compose.dev.yaml)
# DT_TENANT_ID: the env-id prefix, e.g. hzi4275d (from hzi4275d.dev.dynatracelabs.com)
# DT_PAAS_TOKEN: Access Tokens → PaaS token in your tenant
# Without these, accountservice builds fine but ships no agent.
DT_TENANT_ID=fkf7350d
DT_PAAS_TOKEN=
